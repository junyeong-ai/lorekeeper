# A real config and its credentials live at the repo root, which is where `lore` discovers
# them. Anchored: unanchored, these matched at every depth and silently excluded a test
# fixture's own config, leaving CI with a corpus the binary could not read.
/config.yaml
/credentials.json
.lorekeeper/
.DS_Store
target/

.claude/worktrees/
.claude/scheduled_tasks.lock

# Local tool store (symora)
.symora/

# `cargo mutants` run output — build artifacts, regenerated per run.
mutants.out/
mutants.out.old/

# insta writes these on a mismatch; a snapshot is accepted by review, never by a commit
*.snap.new
