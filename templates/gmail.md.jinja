---
id: {{ source_id }}-{{ date }}
title: "{{ i18n.gmail_title }} {{ date }}"
created: {{ date }}
labels: {{ labels | tojson }}
source: {{ source_id }}
event_count: {{ events | length }}
action_required: {{ action_required_count }}
llm_inputs:
  summary: {{ llm_inputs.summary | tojson }}
{%- if llm_inputs.summary_done %}
  summary_done: {{ llm_inputs.summary_done | tojson }}
{%- endif %}
  refine_events: {{ llm_inputs.refine_events | tojson }}
{%- if llm_inputs.refine_events_done %}
  refine_events_done: {{ llm_inputs.refine_events_done | tojson }}
{%- endif %}
{%- if llm_inputs.concepts %}
  concepts: {{ llm_inputs.concepts | tojson }}
{%- endif %}
{%- if llm_inputs.concepts_done %}
  concepts_done: {{ llm_inputs.concepts_done | tojson }}
{%- endif %}
---

# {{ i18n.gmail_title }} {{ date }}

## {{ i18n.summary }}

{{ summary }}

{% if action_required_items %}
## {{ i18n.action_required }}

{% for item in action_required_items %}
- **{{ item.subject }}** {{ i18n.from }} {{ item.sender }} — {{ item.body }}
{% endfor %}

{% endif %}
{% if decisions_items %}
## {{ i18n.decisions }}

{% for item in decisions_items %}
- **{{ item.subject }}** — {{ item.body }}
{% endfor %}

{% endif %}
{% if project_updates_items %}
## {{ i18n.project_updates }}

{% for item in project_updates_items %}
- **{{ item.subject }}** — {{ item.body }}
{% endfor %}

{% endif %}
{% if knowledge_sharing_items %}
## {{ i18n.knowledge_sharing }}

{% for item in knowledge_sharing_items %}
- **{{ item.subject }}** — {{ item.body }}
{% endfor %}

{% endif %}
{% if meeting_followup_items %}
## {{ i18n.meeting_followup }}

{% for item in meeting_followup_items %}
- **{{ item.subject }}** — {{ item.body }}
{% endfor %}

{% endif %}
## {{ i18n.key_events }}

{% for event in events %}
### {{ event.title }}

{{ event.body }}
{% if event.url %}[🔗 {{ i18n.original_link }}]({{ event.url }}){% endif %}

{% endfor %}
{% if extract_concepts %}
## {{ i18n.related_concepts }}

{% for concept in concepts %}
- [[{{ concept }}]]
{% endfor %}
{% endif %}
