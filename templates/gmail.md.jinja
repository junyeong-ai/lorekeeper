---
id: {{ source_id }}-{{ date }}
title: "{{ i18n.gmail_title }} {{ date }}"
created: {{ date }}
labels: {{ labels | tojson }}
source: {{ source_id }}
events_count: {{ events | length }}
action_required: {{ action_count }}
---

# {{ i18n.gmail_title }} {{ date }}

{% if summary %}
## {{ i18n.summary }}

{{ summary }}

{% endif %}
{% if action_required_items %}
## {{ i18n.action_required }}

{% for item in action_required_items %}
- **{{ item.subject }}** {{ i18n.from }} {{ item.sender }} — {{ item.body }}
{% endfor %}

{% endif %}
{% if decision_items %}
## {{ i18n.decisions }}

{% for item in decision_items %}
- **{{ item.subject }}** — {{ item.body }}
{% endfor %}

{% endif %}
{% if project_items %}
## {{ i18n.project_updates }}

{% for item in project_items %}
- **{{ item.subject }}** — {{ item.body }}
{% endfor %}

{% endif %}
{% if knowledge_items %}
## {{ i18n.knowledge_sharing }}

{% for item in knowledge_items %}
- **{{ item.subject }}** — {{ item.body }}
{% endfor %}

{% endif %}
{% if meeting_items %}
## {{ i18n.meeting_followup }}

{% for item in meeting_items %}
- **{{ item.subject }}** — {{ item.body }}
{% endfor %}

{% endif %}
## {{ i18n.key_events }}

{% for event in events %}
### {{ event.title }}

{{ event.body }}
{% if event.url %}[🔗 원본]({{ event.url }}){% endif %}

{% endfor %}
{% if extract_concepts %}
## {{ i18n.related_concepts }}

{% for concept in concepts %}
- [[{{ concept }}]]
{% endfor %}
{% endif %}
