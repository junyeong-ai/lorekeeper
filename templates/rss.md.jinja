{% extends "_daily_base.md.jinja" %}
{% block title %}{{ i18n.rss_title }}{% endblock %}
{# Feed entries lead with provenance (author · link), then the body. #}
{% block events %}
{% for item in events -%}
### {{ item.title | markdown_text }}

{% if item.author %}*{{ item.author | markdown_text }}*{% endif %}{% if item.url %} · {{ item.url | markdown_link("🔗 " ~ i18n.original_link) }}{% endif %}

{{ item.body | markdown_fragment }}

{% endfor %}
{% endblock %}
