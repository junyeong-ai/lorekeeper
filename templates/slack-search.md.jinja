{% extends "_daily_base.md.jinja" %}
{% block title %}{{ i18n.slack_search_title }}{% endblock %}
{% block items_heading %}{{ i18n.key_messages }}{% endblock %}
{% block events %}
{% for event in events %}
### {{ event.title | markdown_text }}

{{ event.body | markdown_fragment }}
{% if event.url %}
{{ event.url | markdown_link(i18n.original_message) }}
{% endif %}

{% endfor %}
{% endblock %}
