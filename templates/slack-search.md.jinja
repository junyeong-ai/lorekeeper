---
id: {{ source_id }}-{{ date }}
title: "{{ i18n.slack_search_title }} {{ date }}"
created: {{ date }}
labels: {{ labels | tojson }}
source: {{ source_id }}
events_count: {{ events | length }}
llm_inputs:
  summary: {{ llm_inputs.summary | tojson }}
  refine_events: {{ llm_inputs.refine_events | tojson }}
{%- if llm_inputs.refine_events_done %}
  refine_events_done: {{ llm_inputs.refine_events_done | tojson }}
{%- endif %}
{%- if llm_inputs.concepts %}
  concepts: {{ llm_inputs.concepts | tojson }}
{%- endif %}
---

# {{ i18n.slack_search_title }} {{ date }}

## {{ i18n.summary }}

{{ summary }}

## {{ i18n.key_messages }}

{% for event in events %}
### {{ event.title }}

{{ event.body }}
{% if event.url %}
[{{ i18n.original_message }}]({{ event.url }})
{% endif %}

{% endfor %}
{% if extract_concepts %}
## {{ i18n.related_concepts }}

{% for concept in concepts %}
- [[{{ concept }}]]
{% endfor %}
{% endif %}
