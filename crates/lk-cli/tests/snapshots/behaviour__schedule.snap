# lorekeeper scheduled tasks
# Paste into your crontab: crontab -e
# Requires: lore in PATH (cargo install --path crates/lk-cli)
# Working dir: <staged>
#
# On macOS prefer `lore schedule --format launchd`: cron SKIPS a job whose time
# passed while the machine was asleep, which silently drops a day's ingest.

# Environment for unattended jobs:
LORE_BIN=lore
LORE_CONFIG=<staged>/corpus/config.yaml
LORE_INSTALL_DATA_DIR=<staged>/data/lorekeeper
PATH=<staged>/tools

0 7 * * * cd <staged> && lore --config <staged>/corpus/config.yaml run daily --wait
*/5 * * * * cd <staged> && lore --config <staged>/corpus/config.yaml task remind notify
